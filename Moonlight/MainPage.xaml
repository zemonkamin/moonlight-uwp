<Page x:Class="Moonlight.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="PageLoaded" Background="Black">
  <Page.BottomAppBar>
    <CommandBar Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" DefaultLabelPosition="Bottom" ClosedDisplayMode="Compact" IsDynamicOverflowEnabled="False">
      <AppBarButton Icon="Add" Label="Add PC" Click="AddHost"/>
      <AppBarButton Icon="Find" Label="Discover" Click="FindHosts"/>
      <AppBarButton Icon="Setting" Label="Settings" Click="OpenSettings"/>
    </CommandBar>
  </Page.BottomAppBar>
  <GridView x:Name="AppList" IsItemClickEnabled="True" ItemClick="PlayGame" SelectionMode="None" Padding="16,20,16,24" SizeChanged="AppListSizeChanged"
            ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
    <GridView.Header>
      <Grid x:Name="HostControls" HorizontalAlignment="Center" Margin="0,0,0,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ComboBox x:Name="HostList" PlaceholderText="Select a PC" AutomationProperties.Name="PC" HorizontalAlignment="Stretch" SelectionChanged="HostChanged"/>
        <Grid Grid.Row="1" Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="PairButton" Content="Pair" Click="PairHost" HorizontalAlignment="Stretch" MinHeight="44" Margin="0,0,4,0"/>
          <Button Grid.Column="1" Content="Refresh" Click="RefreshApps" HorizontalAlignment="Stretch" MinHeight="44" Margin="4,0,4,0"/>
          <Button Grid.Column="2" Click="HostMenu" HorizontalAlignment="Stretch" MinHeight="44" Margin="4,0,0,0" AutomationProperties.Name="PC options" ToolTipService.ToolTip="PC options">
            <SymbolIcon Symbol="More"/>
          </Button>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"/>
          <TextBlock x:Name="Status" Text="Add a PC or discover hosts on your local network." TextWrapping="Wrap" Margin="0,8,0,0" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>
      </Grid>
    </GridView.Header>
    <GridView.ItemsPanel><ItemsPanelTemplate>
      <ItemsWrapGrid Orientation="Horizontal" ItemWidth="144" ItemHeight="246" HorizontalAlignment="Center" Loaded="CardsPanelLoaded"/>
    </ItemsPanelTemplate></GridView.ItemsPanel>
    <GridView.ItemContainerStyle><Style TargetType="GridViewItem">
      <Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style></GridView.ItemContainerStyle>
    <GridView.ItemTemplate><DataTemplate>
      <Border Width="132" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="0" ToolTipService.ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="176"/><RowDefinition Height="56"/></Grid.RowDefinitions>
          <Grid Background="#171717">
            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image Source="{Binding Cover}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw"/>
            <Border Background="#DD000000" Padding="6,3" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="0" Visibility="{Binding RunningVisibility}">
              <TextBlock Text="Running" FontSize="12"/>
            </Border>
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="8,6" FontSize="15" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </DataTemplate></GridView.ItemTemplate>
  </GridView>
</Page>
